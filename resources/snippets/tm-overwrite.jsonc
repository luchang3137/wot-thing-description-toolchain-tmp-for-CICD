/*
---
layout: pre
id: td-model-example-tmRef2
title: Smart Lamp Control extend and overwrite existing definitions
# this example uses "title": null (tm:ref removal), which the TM
# validation schema cannot express, so skip validation
validate: false
---
*/
{
    "@context": [
        "https://www.w3.org/ns/wot-next/td"
    ],
    "@type": "tm:ThingModel",
    "title": "Smart Lamp Control",
    "properties": {
        "dimming": {
            "tm:ref": "http://example.com/SmartLampControlwithDimming.tm.jsonld#/properties/dim",
            "maximum": 80,
            "unit": "%"
        }
    }
}
